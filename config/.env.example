# Router Configuration
APP_NAME=HermesClaw Router
VERSION=0.1.0
PORT=18889
HOST=0.0.0.0

# ========== Local Agents ==========
# Hermes (本地服务)
HERMESCLAW_AGENT_HM=http://localhost:9119

# GPT (本地或代理)
HERMESCLAW_AGENT_GPT=http://localhost:18890

# ========== External API Agents ==========
# Cherry Agent (Agnes AI) - OpenAI-compatible API
# 👇 请替换为你的 Agnes AI API Key
CHERRY_BASE_URL=https://apihub.agnes-ai.com/v1
CHERRY_API_KEY=your_cherry_api_key_here
CHERRY_MODEL=agnes-2.0-flash

# WorkBuddy Agent (SiliconFlow) - OpenAI-compatible API
# 👇 请替换为你的 SiliconFlow API Key
WORKBUDDY_BASE_URL=https://api.siliconflow.cn/v1
WORKBUDDY_API_KEY=your_workbuddy_api_key_here
WORKBUDDY_MODEL=Qwen/Qwen3-8B

# ========== Aggregate Groups ==========
# both: 默认调用外部 API Agent (cherry, wb)
HERMESCLAW_AGGREGATE_BOTH=cherry,wb

# all: 调用所有外部 API Agent
HERMESCLAW_AGGREGATE_ALL=cherry,wb

# ========== OpenClaw Gateway ==========
HERMESCLAW_OPENCLAW_GATEWAY=http://localhost:18789

# ========== Timeouts ==========
HERMESCLAW_REQUEST_TIMEOUT=30
HERMESCLAW_MAX_RETRIES=3

# ========== Logging ==========
HERMESCLAW_LOG_LEVEL=INFO
