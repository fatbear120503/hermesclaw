{
  "version": "3.0.1",
  "comment": "安装后运行 `hermesclaw install` 或编辑此文件添加模型",
  "models": {
    "hermes": {
      "type": "openai_api",
      "enabled": false,
      "name": "自定义智能体",
      "description": "修改启用并填写你的本地或远程 API",
      "url": "http://localhost:8000/v1/chat/completions",
      "model": "your-model-name",
      "system_prompt": "你是一个有用的 AI 助手。",
      "api_key_env": "YOUR_API_KEY",
      "timeout": 30,
      "max_tokens": 4096
    }
  },
  "templates": {
    "openai_compatible": {
      "type": "openai_api",
      "description": "OpenAI-compatible API (通用)"
    },
    "local": {
      "type": "openai_api",
      "description": "本地 LLM 服务 (如 Ollama, vLLM)"
    }
  },
  "settings": {
    "default_model": null,
    "prefix_map": {},
    "aggregator": {
      "enabled": true,
      "model": null
    }
  }
}
