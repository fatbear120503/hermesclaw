#!/bin/bash
# ═══════════════════════════════════════════════════════
# HermesClaw v1.0.1 - 主命令入口（动态路径探测）
# ═══════════════════════════════════════════════════════

# 自动探测安装目录（优先 /usr/local，回退到本地包）
find_hermes_dir() {
    local script_path=""
    if [ -L "$0" ]; then
        script_path=$(readlink "$0" 2>/dev/null || echo "$0")
    else
        script_path="$0"
    fi
    script_path="$(cd "$(dirname "$script_path")" && pwd)"
    
    # 如果脚本在 /usr/local/hermesclaw/bin/ 下 → 用 /usr/local
    if echo "$script_path" | grep -q "/usr/local/hermesclaw"; then
        echo "/usr/local/hermesclaw"
        return
    fi
    
    # 否则尝试 /usr/local（PKG 安装后的标准路径）
    if [ -d "/usr/local/hermesclaw/bin" ]; then
        echo "/usr/local/hermesclaw"
        return
    fi
    
    # 最后回退到开发/本地路径（绝对路径解析）
    cd "$script_path" && cd .. && pwd
}

HERMES_DIR="$(find_hermes_dir)"
CONFIG_DIR="${HERMES_DIR}/config"
SCRIPTS_DIR="${HERMES_DIR}/scripts"
SCRIPTS_V3="${HERMES_DIR}/scripts-v3"

command="${1:-help}"

show_help() {
    cat <<'EOF'
🐿️  HermesClaw v1.0.1 - 多智能体调度系统

命令:
  help              显示帮助
  install           首次安装向导
  add               添加智能体
  edit              编辑智能体
  delete            删除智能体
  list              列出所有智能体
  qrcode            生成微信配置二维码
  status            检查服务状态
  dispatch <agent>: 调用指定智能体
  dispatch all      调用所有智能体

微信使用:
  <agent_id>:问题   → 调用单个智能体
  all:问题          → 调用所有智能体
  all:聚合分析问题   → 深度聚合分析

示例:
  hermesclaw install
  hermesclaw add                    → 交互式添加
  hermesclaw dispatch all "报到"     → 全部调用
EOF
}

case "$command" in
    help|--help|-h)
        show_help
        ;;
    install|setup)
        python3 "${SCRIPTS_DIR}/setup.py" install
        ;;
    add)
        python3 "${SCRIPTS_DIR}/setup.py" add
        ;;
    edit)
        python3 "${SCRIPTS_DIR}/setup.py" edit
        ;;
    delete|remove)
        python3 "${SCRIPTS_DIR}/setup.py" delete
        ;;
    list|ls)
        python3 "${SCRIPTS_DIR}/setup.py" list
        ;;
    qrcode|qr)
        python3 "${SCRIPTS_DIR}/wechat_qr.py"
        ;;
    status)
        python3 "${SCRIPTS_V3}/dispatch.py" status
        ;;
    dispatch)
        shift
        cd "$SCRIPTS_V3" && python3 dispatch.py "$@"
        ;;
    test)
        echo "🧪 运行测试..."
        cd "$SCRIPTS_V3" && python3 dispatch.py all "报到"
        ;;
    *)
        echo "❌ 未知命令: $command"
        show_help
        exit 1
        ;;
esac
