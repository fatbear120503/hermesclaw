# HermesClaw Gateway Environment Template
# 安装后请填写你的真实 API Key

# 1、小松鼠 OpenClaw
OPENCLAW_URL=http://127.0.0.1:18789
# 可选模型列表：caixun-main/kimi-k2.6, deepseek/deepseek-v4-pro 等

# 2、Sensenova
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_MODEL=sensenova-6.7-flash-lite

# 3、Cherry / Agnes AI
CHERRY_BASE_URL=https://api.sensenova.cn/v1
CHERRY_API_KEY=your_cherry_api_key
CHERRY_MODEL=sensenova-6.7-flash-lite

# 4、WorkBuddy / SiliconFlow
WORKBUDDY_BASE_URL=https://api.siliconflow.cn/v1
WORKBUDDY_API_KEY=your_workbuddy_api_key
WORKBUDDY_MODEL=Qwen/Qwen3-8B

# OpenClaw Squirrel (kimi-k2.6)
SQUIRREL_BACKEND=http
SQUIRREL_API_KEY=your_squirrel_api_key
